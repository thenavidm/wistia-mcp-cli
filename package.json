{
  "name": "@thenavidm/wistia-mcp-cli",
  "version": "3.0.0",
  "description": "Wistia modern Data API MCP server and shared task CLI for media, folders, captions, webinars, sharing, accessibility, analytics and uploads.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "wistia-mcp": "dist/index.js",
    "wistia-cli": "dist/index.js",
    "wistia-mcp-cli": "dist/npx.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "build:mcpb": "bash desktop-extension/build.sh",
    "check:counts": "node scripts/check-counts.mjs",
    "sync:api": "node scripts/sync-openapi.mjs"
  },
  "dependencies": {
    "@thenavidm/slipway": "^0.1.20",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://navid.me/mcp-servers/wistia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/wistia-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/wistia-mcp-cli/issues"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md",
    "SKILL.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "CHANGELOG.md",
    "SECURITY.md",
    "COMPARISON.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cli",
    "command-line-tool",
    "wistia",
    "video",
    "video-hosting",
    "media",
    "folders",
    "captions",
    "claude-code",
    "claude-desktop",
    "codex",
    "cursor",
    "ai-agents",
    "typescript",
    "desktop-extension",
    "modern-api",
    "webinars",
    "analytics",
    "uploads",
    "translations",
    "accessibility",
    "private-accounts",
    "api-token",
    "json",
    "gemini-cli",
    "windsurf",
    "open-source"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
